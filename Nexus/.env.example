# NEXUS - Variáveis de ambiente
# Copie este arquivo para .env.local e preencha quando criar seu projeto Supabase

# Supabase (https://supabase.com → New project → API settings)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic Claude API (para Lumi AI - opcional no Sprint 1)
# Em produção isso DEVE ficar no backend (edge function), nunca no frontend
# VITE_ANTHROPIC_API_KEY=

# Spotify (opcional - Music Mood Share, Sprint 8)
# VITE_SPOTIFY_CLIENT_ID=

# Modo de dados (mock | supabase) - default: mock até você configurar Supabase
VITE_DATA_MODE=mock
